PORT=8080

# Legacy TMS — provided via the candidate portal
TMS_HOST=
TMS_PORT=
TMS_AUTH_TOKEN=

# FMCSA QCMobile API — provided via the candidate portal
FMCSA_WEB_KEY=

# Resend — for real OTP email delivery. Falls back to console logging if unset.
RESEND_API_KEY=
OTP_FROM_ADDRESS=onboarding@resend.dev

# TESTING ONLY — force-routes OTP email delivery to this address regardless
# of what the caller states. Leave unset for production.
OTP_TEST_EMAIL_OVERRIDE=
